# Build-time config for the production front end.
# Copy to .env.production (gitignored) or pass as a Docker build arg.
#
# Vite inlines this into the bundle at build time — it is NOT read at runtime,
# so changing it means rebuilding. It is public by design: the browser client
# connects to it directly. It is not a secret.

VITE_CONVEX_URL=https://hardy-dragon-575.eu-west-1.convex.cloud
